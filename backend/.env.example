NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nexus_app:change-me@localhost:5432/data_nexus
DATABASE_MIGRATION_URL=postgresql://nexus_migrator:change-me@localhost:5432/data_nexus
DATABASE_POOL_MAX=10
DATABASE_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
COOKIE_NAME=data_nexus_session
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
LOCAL_STORAGE_PATH=./storage
UPLOAD_MAX_BYTES=26214400
INVITATION_EXPIRES_HOURS=72
PASSWORD_RESET_EXPIRES_MINUTES=30
SMTP_URL=
EMAIL_FROM=Data Nexus <no-reply@example.com>
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Data-Nexus
